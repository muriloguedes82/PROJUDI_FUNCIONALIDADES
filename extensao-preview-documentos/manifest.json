{
  "manifest_version": 3,
  "name": "Olirum para Projudi – Ações Rápidas, Pré-visualização e WhatsApp",
  "short_name": "Olirum Projudi",
  "version": "17",
  "description": "Assistente do Projudi (TJPR): pré-visualiza documentos ao passar o mouse, ações rápidas, preferências e envio por WhatsApp e e-mail.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Olirum – Seu assistente no Projudi",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "identity",
    "storage",
    "alarms",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "windows",
    "downloads",
    "clipboardRead",
    "offscreen",
    "declarativeNetRequestWithHostAccess",
    "system.display"
  ],
  "host_permissions": [
    "*://*.tjpr.jus.br/*",
    "https://web.whatsapp.com/*",
    "https://login.microsoftonline.com/*",
    "https://graph.microsoft.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://*.registros.org.br/*",
    "https://*.cnj.jus.br/*",
    "https://*.pdpj.jus.br/*",
    "https://sso.cloud.pje.jus.br/*",
    "https://*.receita.fazenda.gov.br/*",
    "https://sso.acesso.gov.br/*",
    "https://*.copel.com/*",
    "https://*.sanepar.com.br/*",
    "https://*.depen.pr.gov.br/*",
    "https://*.sesp.parana/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "sistemasCnj",
        "enabled": true,
        "path": "rules/sistemasCnj.json"
      }
    ]
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://outlook.office.com/mail/*",
        "https://outlook.office365.com/mail/*"
      ],
      "js": [
        "src/owa-attach.js"
      ],
      "css": [
        "src/owa-attach.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/whatsapp.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
