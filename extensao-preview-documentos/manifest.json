{
  "manifest_version": 3,
  "name": "Olirum – Projudi/SEEU: Pré-visualização, WhatsApp e E-mail",
  "version": "2.23.4",
  "description": "Ao passar o mouse sobre um documento na tela de Movimentações (Projudi ou SEEU), ou sobre uma pendência de análise de juntada/conclusão do Projudi, exibe a íntegra do(s) arquivo(s) em janela(s) sobreposta(s), sem precisar abri-los em outra aba. Também permite selecionar arquivos do processo e enviá-los por WhatsApp Web ou por e-mail via Outlook.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Olirum – Seu assistente no Projudi e SEEU",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "identity",
    "storage",
    "alarms",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "windows",
    "downloads",
    "clipboardRead",
    "offscreen",
    "declarativeNetRequestWithHostAccess",
    "system.display"
  ],
  "host_permissions": [
    "*://*.tjpr.jus.br/*",
    "*://seeu.pje.jus.br/*",
    "*://seeutreino.pje.jus.br/*",
    "*://*.amazonaws.com/*",
    "https://web.whatsapp.com/*",
    "https://login.microsoftonline.com/*",
    "https://graph.microsoft.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://*.registros.org.br/*",
    "https://*.cnj.jus.br/*",
    "https://*.pdpj.jus.br/*",
    "https://sso.cloud.pje.jus.br/*",
    "https://*.receita.fazenda.gov.br/*",
    "https://sso.acesso.gov.br/*",
    "https://*.copel.com/*",
    "https://*.sanepar.com.br/*",
    "https://*.depen.pr.gov.br/*",
    "https://*.sesp.parana/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "sistemasCnj",
        "enabled": true,
        "path": "rules/sistemasCnj.json"
      }
    ]
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://outlook.office.com/mail/*",
        "https://outlook.office365.com/mail/*"
      ],
      "js": [
        "src/owa-attach.js"
      ],
      "css": [
        "src/owa-attach.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/whatsapp.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
