{
  "manifest_version": 3,
  "name": "Projudi/SEEU - Documentos: Pré-visualização, WhatsApp e E-mail",
  "version": "2.9.78",
  "description": "Pré-visualiza documentos do Projudi/SEEU ao passar o mouse, envia-os por WhatsApp Web ou Outlook e agiliza tarefas do cartório.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "permissions": [
    "identity",
    "storage",
    "unlimitedStorage",
    "scripting",
    "downloads",
    "clipboardRead",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.tjpr.jus.br/*",
    "*://seeu.pje.jus.br/*",
    "*://*.amazonaws.com/*",
    "https://web.whatsapp.com/*",
    "https://login.microsoftonline.com/*",
    "https://graph.microsoft.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tjpr.jus.br/*",
        "*://seeu.pje.jus.br/*"
      ],
      "js": [
        "src/hostGuard.js",
        "src/closeShim.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "*://*.tjpr.jus.br/*",
        "*://seeu.pje.jus.br/*"
      ],
      "js": [
        "src/hostGuard.js",
        "src/uiVisibility.js",
        "src/clipboardProcess.js",
        "src/documentSelection.js",
        "src/content.js",
        "src/email.js",
        "src/quickActions.js",
        "src/remessaMultipla.js",
        "src/buttonDrag.js",
        "src/juntadaDrag.js",
        "src/finalizarConclusao.js",
        "src/mesaAnalistaContadores.js",
        "src/ordenarCumprimentos.js",
        "src/movementHighlight.js",
        "src/expandMovements.js",
        "src/sequencialProcessoPrincipal.js",
        "src/decursoPrazoSequencial.js",
        "src/suspensaoAtiva.js",
        "src/monitoracaoAtiva.js",
        "src/oraculoDirect.js",
        "src/oraculo.js",
        "src/habilitarAdvogado.js",
        "src/editarPartes.js",
        "src/alvaraEletronico.js",
        "src/juntarDocumento.js",
        "src/reusCabecalho.js",
        "src/cpfPartesCumprimentos.js",
        "src/bnmpMandadoPrisao.js"
      ],
      "css": [
        "src/content.css",
        "src/email.css",
        "src/quickActions.css",
        "src/remessaMultipla.css",
        "src/juntadaDrag.css",
        "src/ordenarCumprimentos.css",
        "src/movementHighlight.css",
        "src/reusCabecalho.css",
        "src/cpfPartesCumprimentos.css",
        "src/bnmpMandadoPrisao.css",
        "src/juntarDocumento.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://outlook.office.com/mail/*",
        "https://outlook.office365.com/mail/*"
      ],
      "js": [
        "src/owa-attach.js"
      ],
      "css": [
        "src/owa-attach.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/whatsapp.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
