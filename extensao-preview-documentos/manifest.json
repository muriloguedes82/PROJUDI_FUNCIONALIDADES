{
  "manifest_version": 3,
  "name": "Projudi - Pré-visualização de Documentos",
  "version": "1.1.0",
  "description": "Ao passar o mouse sobre um documento na tela de Movimentações do Projudi, exibe a íntegra do arquivo em uma janela sobreposta, sem precisar abri-lo em outra aba. Também adiciona lembretes em formato post-it, com cor à escolha, compartilhados entre os usuários da extensão.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.tjpr.jus.br/*",
    "https://projudi-lembretes-default-rtdb.firebaseio.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.tjpr.jus.br/projudi/processo.do*",
        "*://*.tjpr.jus.br/projudi/*processo*"
      ],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.tjpr.jus.br/projudi/processo.do*",
        "*://*.tjpr.jus.br/projudi/*processo*"
      ],
      "js": ["src/firebase-config.js", "src/lembretes.js"],
      "css": ["src/lembretes.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
